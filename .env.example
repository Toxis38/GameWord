# Скопируйте этот файл в .env и заполните своими данными
# НЕ коммитьте реальный .env с паролями!

# --- PRIMARY: GMAIL ---
SMTP_GMAIL_HOST=smtp.gmail.com
SMTP_GMAIL_PORT=465
SMTP_GMAIL_SECURE=true
SMTP_GMAIL_USER=your_gmail@gmail.com
SMTP_GMAIL_PASS=your_app_password

# --- FALLBACK: YANDEX ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_app_password
SMTP_FROM=your_email@yandex.ru
